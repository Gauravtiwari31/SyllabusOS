# ── Database ───────────────────────────────────────────────
# Local: `docker compose up -d` starts Postgres + pgvector on :5433.
# Production: Neon pooled URL in DATABASE_URL, direct URL (host WITHOUT "-pooler") in DIRECT_URL.
# Use a database dedicated to SyllabusOS. .env.local overrides this file (Next.js + Prisma CLI).
DATABASE_URL="postgresql://syllabusos:syllabusos@localhost:5433/syllabusos"
DIRECT_URL="postgresql://syllabusos:syllabusos@localhost:5433/syllabusos"

# ── Auth.js ────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Optional. Google sign-in is hidden unless both are set; guest demo always works.
# Authorized redirect URI in Google Cloud: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Gemini (optional) ──────────────────────────────────────
# Without a key the app runs in "offline mode": heuristic syllabus parsing,
# the built-in DBMS question bank, keyword retrieval and a rule-based tutor.
# Check current model ids in Google AI Studio; never hard-code them.
# (gemini-2.5-* are closed to new keys; Pro models need a paid tier.)
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_MODEL_FAST="gemini-3.6-flash"
GEMINI_MODEL_STRONG="gemini-3.6-flash"
# Used when the primary model is overloaded (503) or rate-limited (429). Comma-separated,
# tried in order; an overloaded model is skipped for 2 minutes.
GEMINI_MODEL_FALLBACK="gemini-3.1-flash-lite,gemini-3.5-flash-lite"
GEMINI_EMBED_MODEL="gemini-embedding-001"

# ── File storage (optional) ────────────────────────────────
# If unset, uploads are processed in memory and not archived.
BLOB_READ_WRITE_TOKEN=""

# ── P1 / optional ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
SENTRY_DSN=""

# ── Self-hosting (not needed on Vercel) ────────────────────
# AUTH_URL="https://your-domain"      # canonical origin for Auth.js
# AUTH_TRUST_HOST="true"             # when behind your own reverse proxy
# TRUSTED_PROXY="1"                  # trust X-Real-IP / X-Forwarded-For for rate limits

# ── Android app (Trusted Web Activity) — see docs/ANDROID.md ──
# Served at /.well-known/assetlinks.json. Fingerprints are public values, comma-separated.
ANDROID_PACKAGE_NAME=""
ANDROID_SHA256_CERT_FINGERPRINTS=""
